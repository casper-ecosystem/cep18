{
  "name": "casper-cep18-js-client",
  "version": "2.0.0",
  "description": "Casper CEP-18 JavaScript Client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint src/ --max-warnings=0",
    "lint:write": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src",
    "test:unit": "cross-env NODE_ENV=test jest \"/tests/unit\"",
    "test:e2e": "cross-env NODE_ENV=test jest -i --detectOpenHandles --forceExit \"tests/e2e\"",
    "test": "npm run test:unit && npm run test:e2e",
    "example:install": "tsx examples/install.ts",
    "example:usage": "tsx examples/usage.ts",
    "example:usage2": "tsx examples/usage2.ts",
    "clean": "rm -rf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json",
    "generate:wasm": "tsx --tsconfig tsconfig.json \"src/scripts/copy-and-convert-wasms.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casper-ecosystem/cep18.git",
    "directory": "client-js"
  },
  "keywords": [
    "casper",
    "cep18",
    "fungible token"
  ],
  "author": "casper.network",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/casper-ecosystem/cep18/issues"
  },
  "homepage": "https://github.com/casper-ecosystem/cep18/tree/master/client-js#readme",
  "files": [
    "/dist"
  ],
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "js-base64": "^3.7.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@make-software/ces-js-parser": "^2.0.0-beta1",
    "casper-js-sdk": "^5.0.12-beta2"
  }
}